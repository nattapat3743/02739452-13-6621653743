# คัดลอกเป็น .env แล้วแก้ค่า:  cp .env.example .env
# (ถ้าไม่สร้าง .env ระบบจะใช้ค่าเริ่มต้นเดียวกับในไฟล์นี้)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me

# ดึงข้อมูลย้อนหลังกี่วัน (USGS/EMSC)
QUAKE_LOOKBACK_DAYS=30
